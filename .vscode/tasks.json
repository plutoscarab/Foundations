{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "T4: Transform current template",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/TransformTemplates.ps1",
                "-Template", "${file}"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "T4: Watch templates",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/TransformTemplates.ps1",
                "-Watch"
            ],
            "isBackground": true,
            "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
            "presentation": { "reveal": "silent", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "test",
            "command": "dotnet",
            "group": { "kind": "test", "isDefault": true },
            "args": [
              "test",
              "${workspaceFolder}/UnitTests/UnitTests.csproj",
              "/p:CollectCoverage=true",
              "/p:CoverletOutputFormat=lcov",
              "/p:CoverletOutput=./lcov.info"
            ],
            "type": "process",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/UnitTests/UnitTests.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "fbuild",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/FMath/FMath.fsproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/UnitTests/UnitTests.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/UnitTests/UnitTests.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
